{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.xability/maidr-mcp",
  "title": "maidr",
  "description": "Accessible maidr charts in ChatGPT and Claude, explored by sound, braille and screen reader",
  "repository": {
    "url": "https://github.com/xability/maidr-mcp",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "maidr-mcp",
      "version": "0.1.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--stdio",
          "description": "Serve over stdin and stdout; without it the server listens on HTTP"
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/xability/maidr-mcp:0.1.1",
      "runtimeHint": "docker",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:8000/mcp"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--publish",
          "value": "127.0.0.1:8000:8000",
          "description": "The image serves Streamable HTTP on port 8000; publish it on this machine only"
        }
      ]
    }
  ]
}
